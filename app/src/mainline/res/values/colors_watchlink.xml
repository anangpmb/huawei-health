<?xml version="1.0" encoding="utf-8"?>
<!-- WatchLink "Cocoa" palette: warm off-white page, white cards, deep cocoa as the action colour and
     a set of soft accents (sage, orange, lavender, yellow, pink) for the data.
     Flavor resources override main resources of the same name, so upstream's colors.xml stays
     untouched. Only the light theme is restyled; dark-theme colours are inherited unchanged. -->
<resources>
    <!-- Brand -->
    <color name="primary_light" type="color">#4F3422</color>
    <color name="primarydark_light" type="color">#4F3422</color>
    <color name="accent" type="color">#4F3422</color>
    <color name="subtab_pill_light" type="color">#EFE9E5</color>

    <!-- Surfaces (light): warm off-white page, white cards, warm greys for wells and tracks -->
    <color name="window_background_light" type="color">#F7F4F2</color>
    <color name="surface_container_lowest_light" type="color">#FFFFFF</color>
    <color name="surface_container_low_light" type="color">#FFFFFF</color>
    <color name="surface_container_light" type="color">#F3EFEC</color>
    <color name="surface_container_high_light" type="color">#EDE8E4</color>
    <color name="surface_container_highest_light" type="color">#E5DFDA</color>

    <!-- Text and lines (light) -->
    <color name="primarytext_light" type="color">#1F160F</color>
    <color name="on_surface_variant_light" type="color">#736B66</color>
    <color name="tertiarytext_light" type="color">#C9C1BB</color>
    <color name="outline_light" type="color">#A69E98</color>
    <color name="outline_variant_light" type="color">#EEE9E5</color>
    <color name="row_separator_light" type="color">#F0EBE7</color>
    <color name="table_header_rule_light" type="color">#E5DFDA</color>

    <!-- Data colours -->
    <color name="chart_heartrate" type="color">#F06A8C</color>
    <color name="chart_heartrate_fill" type="color">#FBD5DF</color>
    <color name="chart_heartrate_minimum" type="color">#F7A1B5</color>
    <color name="chart_heartrate_resting" type="color">#9BB068</color>
    <color name="chart_heartrate_maximum" type="color">#E0446A</color>
    <color name="chart_line_heart_rate" type="color">#F06A8C</color>

    <color name="chart_deep_sleep_light" type="color">#6E57D9</color>
    <color name="chart_light_sleep_light" type="color">#B4A6F5</color>
    <color name="chart_rem_sleep_light" type="color">#F0A3C4</color>
    <color name="chart_awake_sleep_light" type="color">#FDBA74</color>

    <color name="chart_activity_light" type="color">#9BB068</color>
    <color name="chart_not_worn_light" type="color">#E3DDD8</color>

    <color name="chart_stress_unknown" type="color">#D9D2CC</color>
    <color name="chart_stress_relaxed" type="color">#A694F5</color>
    <color name="chart_stress_mild" type="color">#9BB068</color>
    <color name="chart_stress_moderate" type="color">#FFBD5A</color>
    <color name="chart_stress_high" type="color">#FE814B</color>

    <color name="steps_color" type="color">#F6B93B</color>
    <color name="calories_color" type="color">#FE814B</color>
    <color name="spo2_color" type="color">#F06A8C</color>
    <color name="spo2_avg_color_light" type="color">#B4325A</color>
    <color name="chart_temperature" type="color">#FE814B</color>
    <color name="body_energy_level_color" type="color">#9BB068</color>
</resources>
